#!/bin/bash
# 1. Pull in Omarchy environment states
[ -f ~/.config/uwsm/env ] && source ~/.config/uwsm/env

# 2. Extract your custom Zsh variables and PATH cleanly without breaking bash execution
if [ -f ~/.zshrc ]; then
  # Runs a quick zsh instance to output your interactive path/vars, then sources them
  eval "$(zsh -i -c 'echo "export PATH=\"$PATH\""')"
fi

# 3. Gather system commands and ALL home files
selection=$({
  compgen -c | sort -u

  fd --type f \
    --exclude ".git" \
    --exclude ".node_modules" \
    --exclude ".cache" \
    --exclude ".mozilla" \
    --exclude ".config" \
    . "$HOME" 2>/dev/null
} | fzf --prompt="Run or Open: " --border=rounded --margin=5%)

# 4. Process the choice
if [ -n "$selection" ]; then
  if [[ "$selection" == /* || "$selection" == ~* ]]; then
    setsid xdg-open "$selection" >/dev/null 2>&1 &
  else
    # Run it through zsh to ensure any custom zsh functions or aliases also work!
    setsid zsh -c "$selection" >/dev/null 2>&1 &
  fi

  sleep 0.2
fi
